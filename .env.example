# PayPal Sandbox Credentials (Get from https://developer.paypal.com/dashboard/)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_ENVIRONMENT=SANDBOX

# Optional AI Models (Gemini or OpenAI - app includes intelligent rule engine fallback if omitted)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# Spending Policy & Guardrails
AUTO_APPROVE_THRESHOLD=350.00
COMPANY_NAME="Acme Tech Labs Inc."
COMPANY_EMAIL="procurement@acmelabs.com"
